S.sanitizePart=function(p) if p:IsA("BasePart") then p.Anchored=false; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true end end
S.loadSkin=function(n)
    local sk=S.WEAPON_SKINS[n]; if not sk then return nil end
    local cache={AWP=S.cachedAwp,["Tommy Gun"]=S.cachedTommy,Minigun=S.cachedMinigun}
    if cache[n] then return cache[n]:Clone() end
    local ok,r=pcall(function() return game:GetObjects(sk.asset) end)
    if ok and r and #r>0 then
        local cont=Instance.new("Model")
        for _,o in ipairs(r) do o.Parent=cont end
        if n=="AWP" then S.cachedAwp=cont elseif n=="Tommy Gun" then S.cachedTommy=cont elseif n=="Minigun" then S.cachedMinigun=cont end
        return cont:Clone()
    end
    return nil
end
S.removeSkin=function() if S.activeSkin and S.activeSkin.Parent then S.activeSkin:Destroy() end; S.activeSkin=nil end
S.applySkin=function(tool)
    if not tool or not tool:IsA("Tool") or tool.Name~="Gun" then return end
    if S.activeSkin and S.activeSkin.Parent then S.activeSkin:Destroy(); S.activeSkin=nil end
    for _,d in ipairs(tool:GetDescendants()) do if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then d.Transparency=1 end end
    if S.skin=="None" then return end
    local sk=S.WEAPON_SKINS[S.skin]; if not sk then return end
    local h=tool:WaitForChild("Handle",3) or tool:FindFirstChildWhichIsA("BasePart"); if not h then return end
    task.spawn(function()
        local m=S.loadSkin(S.skin); if not m then return end
        m.Name=sk.name
        for _,d in ipairs(m:GetDescendants()) do S.sanitizePart(d) end
        if not m.PrimaryPart then m.PrimaryPart=m:FindFirstChildWhichIsA("BasePart") end
        if sk.scale~=1 then pcall(function() m:ScaleTo(sk.scale) end) end
        m:PivotTo(h.CFrame*CFrame.new(sk.position)*sk.rotation)
        for _,p in ipairs(m:GetDescendants()) do
            if p:IsA("BasePart") then
                local w=Instance.new("WeldConstraint"); w.Part0=h; w.Part1=p; w.Parent=p
            end
        end
        m.Parent=tool; S.activeSkin=m
    end)
end
