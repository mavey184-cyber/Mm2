    end
    local VL=S.Create("TextLabel",{Text=tostring(defV),Font=T.FontBold,TextSize=12,TextColor3=Color3.fromRGB(230,230,240),BackgroundTransparency=1,Size=UDim2.fromOffset(40,20),Position=UDim2.new(1,-50,0,8),Parent=f})
    local Track=S.Create("Frame",{Size=UDim2.new(1,-24,0,4),Position=UDim2.new(0,12,0,55),BackgroundColor3=Color3.fromRGB(45,45,55),BorderSizePixel=0,Parent=f},{S.Corner(999)})
    local pct=(defV-minV)/(maxV-minV)
    local Fill=S.Create("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=Color3.fromRGB(120,80,255),BorderSizePixel=0,Parent=Track},{S.Corner(999)})
    local H=S.Create("Frame",{Size=UDim2.fromOffset(14,14),Position=UDim2.new(pct,-7,0.5,-7),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0,Parent=Track},{S.Corner(999)})
    local dr=false
    H.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dr=true end end)
    H.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then dr=false end end)
    UIS.InputChanged:Connect(function(inp)
        if dr and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then
            local p=math.clamp((inp.Position.X-Track.AbsolutePosition.X)/Track.AbsoluteSize.X,0,1)
            local v=math.floor(minV+(maxV-minV)*p)
            H.Position=UDim2.new(p,-7,0.5,-7); Fill.Size=UDim2.new(p,0,1,0); VL.Text=tostring(v)
            pcall(cb,v)
        end
    end)
end

