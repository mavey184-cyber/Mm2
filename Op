-- ==== HELPERS ====
S.Create=function(class,props,children)
    local inst=Instance.new(class)
    for k,v in pairs(props or {}) do inst[k]=v end
    for _,c in ipairs(children or {}) do c.Parent=inst end
    return inst
end
S.Corner=function(r) return S.Create("UICorner",{CornerRadius=UDim.new(0,r or 6)}) end
S.Stroke=function(c,t) return S.Create("UIStroke",{Color=c or T.Stroke,Thickness=t or 1}) end

S.Tween=function(obj,props,time)
    local tw=TweenService:Create(obj,TweenInfo.new(time or 0.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),props)
    tw:Play(); return tw
end

S.Drag=function(handle,frame)
    local dragging,dragStart,startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=frame.Position
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then dragging=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local d=input.Position-dragStart
            frame.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
        end
    end)
end

