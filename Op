S.killAll=function()
    task.spawn(function()
        local c=LocalPlayer.Character; if not c then return end
        local bp=LocalPlayer:FindFirstChild("Backpack")
        local k=c:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))
        if k and c~=k.Parent then k.Parent=c; task.wait(0.1) end
        k=c:FindFirstChild("Knife"); if not k then return end
        local h=k:FindFirstChild("Handle"); local ev=k:FindFirstChild("Events"); local ht=ev and ev:FindFirstChild("HandleTouched")
        if not h or not ht then return end
        local tg={}
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LocalPlayer and p.Character then
                local ph=p.Character:FindFirstChild("HumanoidRootPart"); local hm=p.Character:FindFirstChildOfClass("Humanoid")
                if ph and hm and hm.Health>0 then table.insert(tg,ph) end
            end
        end
        if #tg==0 then return end
        for _,t in ipairs(tg) do pcall(function() h.CFrame=t.CFrame; task.wait(); ht:FireServer(t); task.wait() end) end
    end)
end
S.sexTarget=function(tp)
    if not tp or tp==LocalPlayer then return end
    local c=LocalPlayer.Character; local r=c and c:FindFirstChild("HumanoidRootPart")
    local tc=tp.Character; local tr=tc and tc:FindFirstChild("HumanoidRootPart"); local th=tc and tc:FindFirstChildOfClass("Humanoid")
    if r and tr and th then
        local sp=r.CFrame; th.Sit=true
        for i=1,100 do
            if not tr.Parent or th.Health<=0 then break end
            for j=1,5 do r.CFrame=tr.CFrame*CFrame.new(0,-1,0.2+(j*0.2)); task.wait(0.03) end
            for j=1,5 do r.CFrame=tr.CFrame*CFrame.new(0,-1,1.2-(j*0.2)); task.wait(0.03) end
        end
        th.Sit=false; task.wait(0.3); if r.Parent then r.CFrame=sp end
    end
end
