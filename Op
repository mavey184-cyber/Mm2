    end
    local Page=S.Create("ScrollingFrame",{
        Size=UDim2.new(1,-24,1,-46),Position=UDim2.fromOffset(12,40),
        BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,
        CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,
        Visible=false,Parent=Content,
    })
    S.Create("UIListLayout",{Padding=UDim.new(0,10),SortOrder=Enum.SortOrder.LayoutOrder,Parent=Page})
    local obj={Btn=Btn,Title=Title,Bar=Bar,Glow=Glow,Page=Page}
    table.insert(S.NavItems,obj)
    local function select()
        for _,it in ipairs(S.NavItems) do
            it.Page.Visible=false
            S.Tween(it.Btn,{BackgroundTransparency=1},0.15)
            S.Tween(it.Title,{TextColor3=T.TextSecondary},0.15)
            S.Tween(it.Bar,{BackgroundTransparency=1},0.15)
            S.Tween(it.Glow,{ImageTransparency=1},0.2)
        end
        Page.Visible=true
        S.Tween(Btn,{BackgroundTransparency=0},0.15)
        S.Tween(Title,{TextColor3=T.TextPrimary},0.15)
        S.Tween(Bar,{BackgroundTransparency=0},0.15)
        Glow.ImageTransparency=1; S.Tween(Glow,{ImageTransparency=0.55},0.35)
    end
    Btn.MouseButton1Click:Connect(select)
    if #S.NavItems==1 then select() end
    return Page
end

