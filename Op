S.fling={active=false,queue={},idx=1,conn=nil,pos=nil,camSubject=nil}
S.cleanupFling=function()
    if S.fling.conn then S.fling.conn:Disconnect(); S.fling.conn=nil end
    S.fling.active=false
    if S.fling.camSubject then pcall(function() Camera.CameraSubject=S.fling.camSubject end); S.fling.camSubject=nil
    else local c=LocalPlayer.Character; local h=c and c:FindFirstChildOfClass("Humanoid"); if h then pcall(function() Camera.CameraSubject=h end) end end
    local c=LocalPlayer.Character
    if c then
        local r=c:FindFirstChild("HumanoidRootPart"); local h=c:FindFirstChildOfClass("Humanoid")
        if r then
            for _,ch in pairs(r:GetChildren()) do
                if ch:IsA("BodyVelocity") or ch:IsA("BodyGyro") or ch:IsA("LinearVelocity") then ch:Destroy() end
            end
        end
        if h then pcall(function() h.PlatformStand=false; h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    end
end
S.startFling=function(tp)
    if not tp or not tp.Character then return end
    local tc=tp.Character; local th=tc:FindFirstChildOfClass("Humanoid"); local tr=th and th.RootPart; local head=tc:FindFirstChild("Head")
    if not head and not tr then return end
    local mc=LocalPlayer.Character; if not mc then return end
    local mhrp=mc:FindFirstChild("HumanoidRootPart"); local mh=mc:FindFirstChildOfClass("Humanoid")
    if not mhrp or not mh then return end
    S.cleanupFling()
    S.fling.active=true; S.fling.camSubject=Camera.CameraSubject
    Camera.CameraSubject=head or th
    local bv=Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(1e6,1e6,1e6); bv.Velocity=Vector3.new(9e8,9e8,9e8); bv.Parent=mhrp
    S.fling.conn=RunService.Stepped:Connect(function()
        if not S.fling.active then return end
        local t=tp.Character; if not t or not t.Parent then S.cleanupFling(); return end
        local th2=t:FindFirstChild("HumanoidRootPart"); local hd=t:FindFirstChild("Head")
        local part=hd or th2; if not part then S.cleanupFling(); return end
        local mv=part.AssemblyLinearVelocity.Magnitude
        if mv>780 then S.cleanupFling(); return end
        mhrp.CFrame=CFrame.new(part.Position+Vector3.new(math.random(-3,3),math.random(-1,1),math.random(-3,3)))*CFrame.Angles(math.random()*6,math.random()*6,math.random()*6)
        pcall(function() mhrp.Velocity=Vector3.new(9e7,1.8e9,9e7); mhrp.RotVelocity=Vector3.new(9e8,9e8,9e8) end)
    end)
    task.delay(12,function() if S.fling.active then S.cleanupFling() end end)
end
S.flingMurderer=function() local m=S.getByRole("Murder"); if m and m~=LocalPlayer then S.startFling(m) end end
S.flingSheriff=function() local s=S.getByRole("Sheriff"); if s and s~=LocalPlayer then S.startFling(s) end end
S.flingAll=function()
    local mc=LocalPlayer.Character; local mhrp=mc and mc:FindFirstChild("HumanoidRootPart")
    local list={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character and mhrp then
            local hrp=p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then table.insert(list,{p=p,d=(mhrp.Position-hrp.Position).Magnitude}) end
        end
    end
    if #list==0 then return end
    table.sort(list,function(a,b) return a.d<b.d end)
    S.startFling(list[1].p)
end

