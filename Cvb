local round_mod=nil
local function get_round()
    if round_mod then return round_mod end
    local ok,m=pcall(function()
        return require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CurrentRoundClient"))
    end)
    if ok and type(m)=="table" then round_mod=m end
    return round_mod
end
local function get_roles()
    local out={}
    local m=get_round(); local d=m and m.PlayerData
    if type(d)=="table" then
        for name,info in pairs(d) do
            if type(info)=="table" and not info.Dead then out[name]=info.Role end
        end
    end
    for _,p in ipairs(Players:GetPlayers()) do
        local c=p.Character; local bp=p:FindFirstChildOfClass("Backpack")
        local hasGun=(c and c:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun"))
        local hasKnife=(c and c:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife"))
        if hasGun and out[p.Name]~="Murderer" then out[p.Name]="Sheriff" end
        if hasKnife then out[p.Name]="Murderer" end
    end
    return out
end
local function my_role()
    local m=get_round(); local d=m and m.PlayerData; local me=d and d[LP.Name]
    return me and me.Role or nil
end
local function holds(c,n) return c~=nil and c:FindFirstChild(n)~=nil end
local function lp_has_gun() return holds(LP.Character,"Gun") or holds(LP:FindFirstChildOfClass("Backpack"),"Gun") end
local function get_hrp() local c=LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function has_knife()
    local c=LP.Character; if c and c:FindFirstChild("Knife") then return true end
    local bp=LP:FindFirstChildOfClass("Backpack")
    if bp and bp:FindFirstChild("Knife") then return true end
    return false
end

-- SILENT AIM
local target_player,target_char,target_part,target_hum
local function refresh_target()
    local found=nil
    local m=get_round(); local data=m and m.PlayerData or nil
    if type(data)=="table" then
        local me=data[LP.Name]
        ST.am_sheriff=(me~=nil and (me.Role=="Sheriff" or me.Role=="Hero")) or lp_has_gun()
        for name,d in pairs(data) do
            if type(d)=="table" and d.Role=="Murderer" and not d.Dead then
                found=Players:FindFirstChild(name); break
            end
        end
    else ST.am_sheriff=lp_has_gun() end
    if not found then
        local my=get_hrp()
        if my then
            local best,bd=nil,math.huge
            for _,p in ipairs(Players:GetPlayers()) do
                if p~=LP and p.Character then
                    local hum=p.Character:FindFirstChildOfClass("Humanoid")
                    local hrp=p.Character:FindFirstChild("HumanoidRootPart")
                    if hum and hrp and hum.Health>0 then
                        local d=(hrp.Position-my.Position).Magnitude
                        if d<bd then bd=d; best=p end
                    end
                end
            end
            found=best
        end
    end
    if found~=target_player then target_player,target_char,target_part,target_hum=found,nil,nil,nil end
    if not found then return end
    local char=found.Character
    if char~=target_char then target_char,target_part,target_hum=char,nil,nil end
    if not char then return end
    if not target_part or not target_part.Parent then
        target_part=char:FindFirstChild(ST.hit_part) or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    end
    if not target_hum or not target_hum.Parent then target_hum=char:FindFirstChildOfClass("Humanoid") end
end
local function target_alive()
    if not target_part or not target_part.Parent then return false end
    if not target_hum or not target_hum.Parent then return false end
    return target_hum.Health>0
end
local hist={}
local function push_hist(pos,t)
    table.insert(hist,1,{p=pos,t=t})
    if #hist>12 then table.remove(hist) end
end
local function est_vel()
    if #hist<3 then return Vector3.zero end
    local n,o=hist[1],hist[#hist]
    local dt=n.t-o.t
    if dt<=0.001 then return Vector3.zero end
    return (n.p-o.p)/dt
end
local function ping_sec()
    local ok,ms=pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if ok and type(ms)=="number" and ms>0 and ms<800 then return ms/1000 end
    local ok2,p=pcall(function() return LP:GetNetworkPing() end)
    if ok2 and type(p)=="number" then return p end
    return 0.05
end
local ray=RaycastParams.new(); ray.FilterType=Enum.RaycastFilterType.Exclude; ray.IgnoreWater=true
local function los_clear(origin,point)
    if not origin or not point then return false end
    local d=point-origin
    if d.Magnitude<0.5 then return true end
    ray.FilterDescendantsInstances={LP.Character}
    local h=workspace:Raycast(origin,d,ray)
    if not h then return true end
    if target_char and (h.Instance==target_char or h.Instance:IsDescendantOf(target_char)) then return true end
    return (h.Position-origin).Magnitude>=d.Magnitude-0.75
end
local function aim_point(origin,strict)
    if not target_part or not target_part.Parent then return nil end
    local base=target_part.Position
    if ST.predict then
        local v=est_vel(); local lead=ping_sec()+0.03
        base=base+v*lead
        local hrp=target_char and target_char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.AssemblyLinearVelocity.Y<-5 then
            base=base+Vector3.new(0,-0.5*workspace.Gravity*lead*lead,0)
        end
    end
    if not origin then return base end
    if los_clear(origin,base) then return base end
    if strict then return nil end
    for _,n in ipairs({"Head","HumanoidRootPart","UpperTorso","Torso"}) do
        local p=target_char and target_char:FindFirstChild(n)
        if p and los_clear(origin,p.Position) then return p.Position end
    end
    return base
end
local force_att,force_saved,force_stamp
local function gun_att()
    local hrp=get_hrp()
    return hrp and hrp:FindFirstChild("GunRaycastAttachment"),hrp
end
local function origin_cf()
    local att,hrp=gun_att(); if att then return att.WorldCFrame end
    if hrp then return hrp.CFrame end
end
local function restore_origin()
    local att=force_att; if not att then return end
    local s=force_saved; force_att,force_saved=nil,nil
    if s then pcall(function() if att.Parent then att.CFrame=s end end) end
end
local function push_origin(cf)
    local att=gun_att(); if not att then return false end
    if force_att and force_att~=att then restore_origin() end
    if not force_att then
        local ok,s=pcall(function() return att.CFrame end)
        if not ok then return false end
        force_att,force_saved=att,s
    end
    force_stamp=os.clock()
    local ok=pcall(function() att.WorldCFrame=cf end)
    if not ok then restore_origin() return false end
    task.defer(restore_origin); return true
end
local function resolve_shot()
    if not ST.silent or not target_alive() then return nil end
    local cf=origin_cf(); local origin=cf and cf.Position or nil
    local aim=aim_point(origin,false); if not aim then return nil end
    if ST.force then
        local dir=(aim-(origin or aim)).Unit
        if dir.Magnitude>0 then
            local back=aim-dir*ST.stand_off
            if push_origin(CFrame.new(back,aim)) then return CFrame.new(aim) end
        end
    end
    return CFrame.new(aim)
end
local weapon_service,orig_mouse,orig_screen,hook_mouse,hook_screen
local function get_weapon_service()
    if weapon_service then return weapon_service end
    local ok,m=pcall(function()
        return require(ReplicatedStorage:WaitForChild("ClientServices"):WaitForChild("WeaponService"))
    end)
    if ok and type(m)=="table" then weapon_service=m end
    return weapon_service
end
local function install_hooks()
    local m=get_weapon_service(); if not m then return end
    if not hook_mouse then
        hook_mouse=function(self,...)
            local ok,cf=pcall(resolve_shot); if ok and cf then return cf end
            return orig_mouse(self,...)
        end
        hook_screen=function(self,x,y,...)
            local ok,cf=pcall(resolve_shot); if ok and cf then return cf end
            return orig_screen(self,x,y,...)
        end
    end
    pcall(function() setreadonly(m,false) end)
    if type(m.GetMouseTargetCFrame)=="function" and m.GetMouseTargetCFrame~=hook_mouse then
        orig_mouse=m.GetMouseTargetCFrame
        pcall(function() m.GetMouseTargetCFrame=hook_mouse end)
    end
    if type(m.GetTargetPosition)=="function" and m.GetTargetPosition~=hook_screen then
        orig_screen=m.GetTargetPosition
        pcall(function() m.GetTargetPosition=hook_screen end)
    end
end
local function get_gun()
    local c=LP.Character
    if c then local g=c:FindFirstChild("Gun") if g then return g,true end end
    local bp=LP:FindFirstChildOfClass("Backpack")
    if bp then local g=bp:FindFirstChild("Gun") if g then return g,false end end
    return nil,false
end
local function fire_gun(gun,a,b)
    if not gun or not a or not b then return false end
    local r=gun:FindFirstChild("Shoot")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function() r:FireServer(a,b) end)
end
local function auto_step(now)
    if not ST.auto_shoot or not ST.silent or not ST.am_sheriff then return end
    if getgenv().AUTOFARM_HOLD then return end
    if not target_alive() then return end
    local gun,eq=get_gun(); if not gun then return end
    if not eq then
        local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum:EquipTool(gun) end) end
        return
    end
    if now-ST.last_shot<math.max(ST.auto_delay,0) then return end
    local cf=origin_cf(); if not cf then return end
    local aim=aim_point(cf.Position,true); if not aim then return end
    if ST.force then
        local dir=(aim-cf.Position).Unit
        push_origin(CFrame.new(aim-dir*ST.stand_off,aim))
    end
    if fire_gun(gun,cf,CFrame.new(aim)) then ST.last_shot=now end
end

