-- AUTO FARM
local farm_cfg = { on=false, mode="Basic", avoid_murder=false, auto_reset=false,
    speed=23, down_depth=14, avoid_dist=40, rise_safe_dist=20 }
local nc_cache = {}; local was_down=false; local down_ref_y=nil; local last_touch=0
local farm_target=nil; local collected_ids={}; local collected_count=0
local coins_done=false; local saw_coins=false
getgenv().AUTOFARM_HOLD=false
local function farm_hrp() local c=LP.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function get_round_data() local m=get_round(); return m and m.PlayerData end
local function can_farm()
    local char=LP.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return false end
    local d=get_round_data()
    if type(d)=="table" then
        local me=d[LP.Name]
        if not me or not me.Role or me.Dead then return false end
    end
