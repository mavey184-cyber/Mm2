    Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
    b.MouseButton1Click:Connect(function()
        local flag=feat.flag
        local new=not ST.quick_state[flag]
        ST.quick_state[flag]=new
        if flag=="silent" then
            ST.silent=new; getgenv().SILENT_AIM_ACTIVE=new
            if new then task.spawn(install_hooks) end
        elseif flag=="auto_shoot" then ST.auto_shoot=new
        elseif flag=="getgun" then ST.getgun=new
        elseif flag=="esp" then ST.esp_on=new end
    end)
    qbuttons[feat.name]=b
end
local function place_quick()
    local y=ST.quick_offset_y; local c=ST.quick_corner
    if c=="Bottom-Right" then qholder.Position=UDim2.new(1,-150,1,-y); qlist.HorizontalAlignment=Enum.HorizontalAlignment.Right
    elseif c=="Bottom-Left" then qholder.Position=UDim2.new(0,10,1,-y); qlist.HorizontalAlignment=Enum.HorizontalAlignment.Left
    elseif c=="Top-Right" then qholder.Position=UDim2.new(1,-150,0,50); qlist.HorizontalAlignment=Enum.HorizontalAlignment.Right
    elseif c=="Top-Left" then qholder.Position=UDim2.new(0,10,0,50); qlist.HorizontalAlignment=Enum.HorizontalAlignment.Left end
end
RunService.RenderStepped:Connect(function()
    if not ST.quick then return end
    for _,f in ipairs(ST.quick_features) do
        local b=qbuttons[f.name]
        if b then
            local on=ST.quick_state[f.flag]
            b.Text=f.name..": "..(on and "ON" or "OFF")
            b.TextColor3=on and Color3.fromRGB(120,220,150) or TEXT_DIM
        end
    end
end)

