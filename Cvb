    body.AutomaticSize=Enum.AutomaticSize.Y; body.BackgroundTransparency=1; body.Parent=panel
    local bl=Instance.new("UIListLayout",body); bl.Padding=UDim.new(0,2)
    local pad=Instance.new("UIPadding",body); pad.PaddingBottom=UDim.new(0,4)

    local P={body=body}
    function P:Toggle(label,default,cb)
        local row=Instance.new("Frame")
        row.Size=UDim2.new(1,0,0,20); row.BackgroundTransparency=1; row.Parent=body
        local lbl=Instance.new("TextLabel")
        lbl.Size=UDim2.new(1,-50,1,0); lbl.Position=UDim2.new(0,4,0,0)
        lbl.BackgroundTransparency=1; lbl.Text=label; lbl.TextColor3=TEXT_MAIN
        lbl.TextSize=10; lbl.Font=Enum.Font.Gotham
        lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
        local tbg=Instance.new("Frame")
        tbg.Size=UDim2.fromOffset(24,13); tbg.Position=UDim2.new(1,-28,0.5,-6.5)
        tbg.BackgroundColor3=default and BG_ON or BG_OFF
        tbg.BackgroundTransparency=ROW_TRANS; tbg.Parent=row
        Instance.new("UICorner",tbg).CornerRadius=UDim.new(1,0)
        local ball=Instance.new("Frame")
        ball.Size=UDim2.fromOffset(9,9)
        ball.Position=default and UDim2.new(1,-11,0.5,-4.5) or UDim2.new(0,2,0.5,-4.5)
        ball.BackgroundColor3=Color3.fromRGB(30,30,35); ball.Parent=tbg
        Instance.new("UICorner",ball).CornerRadius=UDim.new(1,0)
        local btn=Instance.new("TextButton"); btn.Size=UDim2.new(1,0,1,0)
        btn.BackgroundTransparency=1; btn.Text=""; btn.Parent=tbg
        local st=default
        local function refresh()
            TweenService:Create(ball,TweenInfo.new(0.15),{Position=st and UDim2.new(1,-11,0.5,-4.5) or UDim2.new(0,2,0.5,-4.5)}):Play()
            TweenService:Create(tbg,TweenInfo.new(0.15),{BackgroundColor3=st and BG_ON or BG_OFF,BackgroundTransparency=ROW_TRANS}):Play()
        end
        btn.MouseButton1Click:Connect(function()
            st=not st; refresh()
            if cb then pcall(cb,st) end
        end)
    end
    function P:Button(label,cb)
        local btn=Instance.new("TextButton")
        btn.Size=UDim2.new(1,0,0,20)
        btn.BackgroundColor3=BG_ROW; btn.BackgroundTransparency=ROW_TRANS
        btn.Text=label; btn.TextColor3=TEXT_MAIN; btn.TextSize=10
        btn.Font=Enum.Font.Gotham; btn.Parent=body
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,4)
        btn.MouseButton1Click:Connect(function() if cb then pcall(cb) end end)
    end
    function P:Slider(label,default,min,max,cb)
        local row=Instance.new("Frame")
        row.Size=UDim2.new(1,0,0,28); row.BackgroundTransparency=1; row.Parent=body
        local lbl=Instance.new("TextLabel")
        lbl.Size=UDim2.new(1,0,0,12); lbl.BackgroundTransparency=1
        lbl.Text=label..": "..tostring(default)
        lbl.TextColor3=TEXT_MAIN; lbl.TextSize=10; lbl.Font=Enum.Font.Gotham
        lbl.TextXAlignment=Enum.TextXAlignment.Left; lbl.Parent=row
        local track=Instance.new("Frame")
        track.Size=UDim2.new(1,0,0,4); track.Position=UDim2.new(0,0,0,17)
        track.BackgroundColor3=BG_SLIDER; track.BackgroundTransparency=ROW_TRANS; track.Parent=row
        Instance.new("UICorner",track).CornerRadius=UDim.new(1,0)
        local fill=Instance.new("Frame")
        fill.Size=UDim2.new((default-min)/(max-min),0,1,0); fill.BackgroundColor3=ACCENT2; fill.Parent=track
        Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
        local drag=false
        local function upd(i)
            local p=math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
            fill.Size=UDim2.new(p,0,1,0)
            local v=math.floor(min+(max-min)*p)
            lbl.Text=label..": "..tostring(v)
            if cb then cb(v) end
        end
        track.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true; upd(i) end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
        end)
        UIS.InputChanged:Connect(function(i)
            if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i) end
        end)
    end
    function P:Dropdown(label,values,default,cb)
        local row=Instance.new("TextButton")
        row.Size=UDim2.new(1,0,0,20)
        row.BackgroundColor3=BG_ROW; row.BackgroundTransparency=ROW_TRANS
        row.Text=label..": "..tostring(default); row.TextColor3=TEXT_MAIN
        row.TextSize=10; row.Font=Enum.Font.Gotham; row.Parent=body
        Instance.new("UICorner",row).CornerRadius=UDim.new(0,4)
        local idx=1
        for i,v in ipairs(values) do if v==default then idx=i end end
        row.MouseButton1Click:Connect(function()
            idx=idx%#values+1
            local v=values[idx]
            row.Text=label..": "..tostring(v)
            if cb then pcall(cb,v) end
        end)
    end
    return P
end

