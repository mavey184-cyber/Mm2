local function esp_step()
    if not ST.esp_on then
        for plr,d in pairs(esp_cache) do remove_esp(d); esp_cache[plr]=nil end
        clear_highlights(); return
    end
    local cam=workspace.CurrentCamera; if not cam then return end
    local roles=get_roles(); update_highlights(roles)
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and plr.Character then
            local char=plr.Character
            local hrp=char:FindFirstChild("HumanoidRootPart")
            local hum=char:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health>0 then
                local dist=(hrp.Position-cam.CFrame.Position).Magnitude
                local d=esp_cache[plr]; if not d then d=make_esp(); esp_cache[plr]=d end
                if dist>ST.esp_max_dist then
                    for k,v in pairs(d) do
                        if type(v)=="table" then for _,l in ipairs(v) do l.Visible=false end
                        else v.Visible=false end
                    end
                else
                    local cf=hrp.CFrame
                    local corners={Vector3.new(-2,2.75,-1),Vector3.new(2,2.75,-1),Vector3.new(-2,-2.75,-1),Vector3.new(2,-2.75,-1),Vector3.new(-2,2.75,1),Vector3.new(2,2.75,1),Vector3.new(-2,-2.75,1),Vector3.new(2,-2.75,1)}
                    local minX,minY=math.huge,math.huge
                    local maxX,maxY=-math.huge,-math.huge
                    local valid=true
                    for _,o in ipairs(corners) do
                        local vp,on=cam:WorldToViewportPoint((cf*CFrame.new(o)).Position)
                        if vp.Z<=0 then valid=false break end
                        if on then
                            minX=math.min(minX,vp.X); minY=math.min(minY,vp.Y)
                            maxX=math.max(maxX,vp.X); maxY=math.max(maxY,vp.Y)
                        end
                    end
                    if valid and minX<maxX and minY<maxY then
                        local bw=maxX-minX; local bh=maxY-minY
                        d.Box.Size=Vector2.new(bw,bh); d.Box.Position=Vector2.new(minX,minY)
                        d.Box.Color=ST.esp_box_col; d.Box.Visible=ST.esp_box
                        d.Name.Text=plr.Name; d.Name.Position=Vector2.new(minX+bw/2,minY-16)
                        d.Name.Color=ST.esp_name_col; d.Name.Visible=ST.esp_name
                        d.Dist.Text=string.format("%dm",math.floor(dist)); d.Dist.Position=Vector2.new(minX+bw/2,maxY+2)
                        d.Dist.Color=ST.esp_dist_col; d.Dist.Visible=ST.esp_dist
                        local hf=hum.Health/hum.MaxHealth
                        d.HealthBg.Size=Vector2.new(3,bh); d.HealthBg.Position=Vector2.new(minX-6,minY)
                        d.HealthBg.Visible=ST.esp_health
