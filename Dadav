    }
    local SND_LIST={"primordial","neverlose","sparkle","mc bow","skeet","break","rust","applepay","bubble","combobreak","killcard","xp","na naxuy","stony","hentai"}
    local SND_CACHE_DIR="DaDa_sounds/"
    local SND_BASE="https://github.com/khenn791/lmao/raw/refs/heads/main/"
    local snd_cache={}
    local function snd_download(name)
        if snd_cache[name] then return snd_cache[name] end
        if type(isfile)~="function" or type(writefile)~="function" then return nil end
        local path=SND_CACHE_DIR..name..".ogg"
        if isfile(path) then
            local ok,id=pcall(getcustomasset,path)
            if ok and id then snd_cache[name]=id return id end
        end
        if type(isfolder)~="function" or type(makefolder)~="function" then return nil end
        pcall(function() if not isfolder(SND_CACHE_DIR) then makefolder(SND_CACHE_DIR) end end)
        local url=SND_BASE..(name:gsub(" ","%%20"))..".ogg"
        local ok,data=pcall(function() return game:HttpGet(url) end)
        if not ok or type(data)~="string" or #data<1024 then return nil end
        if not pcall(writefile,path,data) then return nil end
        local ok2,id=pcall(getcustomasset,path)
        if ok2 and id then snd_cache[name]=id return id end
        return nil
    end
    local function snd_play(name,vol)
        local id=snd_download(name)
        if not id then return end
        local s=Instance.new("Sound")
        s.SoundId=id; s.Volume=vol or 1
        s.Parent=game:GetService("SoundService")
        s:Play()
        task.delay(8,function() pcall(function() s:Destroy() end) end)
    end
    SHF.snd_play=snd_play
    SHF.snd_list=SND_LIST

    -- Gun hook для kill sounds
    local gun_conn=nil; local last_murder_name=nil; local killed_flag=false
    local function my_role_sh()
        local m=get_round(); local d=m and m.PlayerData; local me=d and d[LP.Name]
        return me and me.Role or nil
    end
    local function murderer_player()
        local d=get_round(); d=d and d.PlayerData
        if type(d)~="table" then return nil end
        for name,info in pairs(d) do
            if type(info)=="table" and info.Role=="Murderer" then return Players:FindFirstChild(name) end
        end
        return nil
    end
    local function lp_has_gun_sh()
        local char=LP.Character
        if char and char:FindFirstChild("Gun") then return true end
        local bp=LP:FindFirstChildOfClass("Backpack")
        if bp and bp:FindFirstChild("Gun") then return true end
        return false
    end
    local function on_shot_sh()
        if not (SHF.kill_sound or SHF.sheriff_sound) then return end
        local role=my_role_sh()
        local mp=murderer_player()
        if not mp then return end
        local mname=mp.Name
        task.delay(0.7,function()
            local d=get_round(); d=d and d.PlayerData
            local info=d and d[mname]
            local tgt=Players:FindFirstChild(mname)
            local hum=tgt and tgt.Character and tgt.Character:FindFirstChildOfClass("Humanoid")
            local killed=(info and info.Dead==true) or (hum~=nil and hum.Health<=0)
            if killed then
                if role=="Sheriff" or role=="Hero" or lp_has_gun_sh() then
                    if SHF.sheriff_sound then snd_play(SHF.sheriff_sound_name, SHF.sheriff_sound_vol) end
                elseif role=="Murderer" then
                    if SHF.kill_sound then snd_play(SHF.kill_sound_name, SHF.kill_sound_vol) end
                end
            end
        end)
    end
    local function ensure_gun_hook_sh()
        if gun_conn then return end
        local ok,remote=pcall(function()
            return ReplicatedStorage:WaitForChild("ClientServices"):WaitForChild("WeaponService"):WaitForChild("GunFired")
        end)
        if not ok or not remote then return end
        gun_conn=remote.OnClientEvent:Connect(function(gun)
            local char=LP.Character
            if typeof(gun)=="Instance" and char and gun:IsDescendantOf(char) then
                on_shot_sh()
            end
        end)
    end
    task.spawn(function()
        while true do
            if SHF.kill_sound or SHF.sheriff_sound then
                ensure_gun_hook_sh()
            end
            task.wait(0.5)
        end
    end)
end
