            if v and v.Parent and v:IsA("BasePart") then
                if v:GetAttribute("Collected") then local id=v:GetAttribute("CoinID"); if id and not collected_ids[id] then collected_ids[id]=true; collected_count=collected_count+1 end
                elseif not v:GetAttribute("Delete") then list[#list+1]=v end
            end
        end
        local function finish()
