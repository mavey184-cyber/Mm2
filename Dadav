    -- MOVEMENT GRAPH
    do
        local lines={} local shadows={} local history={} local accum=0
        RunService.RenderStepped:Connect(function(dt)
            if not SHF.mov_graph then
                for i=1,#lines do lines[i].Visible=false shadows[i].Visible=false end
                return
            end
            local char=LP.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local vel=hrp.AssemblyLinearVelocity
            local sp=math.sqrt(vel.X*vel.X+vel.Z*vel.Z)
            accum=accum+dt
            if accum>=0.05 then
                accum=0
                table.insert(history,{t=os.clock(),v=sp})
                if #history>60 then table.remove(history,1) end
            end
            local cam=workspace.CurrentCamera
            local vp=cam.ViewportSize
            local w=280 h=72 cx=vp.X/2 cy=vp.Y/2+180
            while #lines<#history do
                local l=Drawing.new("Line") l.Thickness=1 l.Color=SHF.mov_graph_col l.Visible=false table.insert(lines,l)
                local s=Drawing.new("Line") s.Thickness=3 s.Color=Color3.new(0,0,0) s.Visible=false table.insert(shadows,s)
            end
            for i=1,#history-1 do
                local a=history[i] local b=history[i+1]
                local ax=cx-w/2+(i/#history)*w
                local bx=cx-w/2+((i+1)/#history)*w
                local ay=cy-math.clamp(a.v/50,-1,1)*h/2
                local by=cy-math.clamp(b.v/50,-1,1)*h/2
                lines[i].From=Vector2.new(ax,ay) lines[i].To=Vector2.new(bx,by) lines[i].Visible=true
                shadows[i].From=Vector2.new(ax,ay) shadows[i].To=Vector2.new(bx,by) shadows[i].Visible=true
            end
        end)
    end
    -- AUTO MAP VOTE
    do
        local sel_map={}
        local pad_conns={}
        local hold_conn,tally_conn,spawn_conn=nil,nil,nil
        local root,lobby_conn=nil,nil
        local session=0
        local running=false
        local spot=nil
        local origin=nil
        local dupe_used=0
        local dupe_mark=0
        local function clearConns()
            for _,c in ipairs({hold_conn,tally_conn,spawn_conn}) do
                if c then pcall(function() c:Disconnect() end) end
            end
            hold_conn,tally_conn,spawn_conn=nil,nil,nil
        end
        local function finish() clearConns() running=false spot=nil dupe_used=0 origin=nil end
        local function stand_point(pad)
            local params=RaycastParams.new()
            params.FilterType=Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances={LP.Character,root}
            local hit=workspace:Raycast(pad.Position+Vector3.new(0,8,0),Vector3.new(0,-40,0),params)
            local y=hit and (hit.Position.Y+3.2) or pad.Position.Y
            return Vector3.new(pad.Position.X,y,pad.Position.Z)
        end
        local function plant(pt)
            local char=LP.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return false end
            hrp.CFrame=CFrame.new(pt)
            return true
        end
        local function tally_of(e) return tonumber(string.match(e.tally.Text,"%d+")) or 0 end
        local function shape(m)
            local pad=m:FindFirstChild("Pad")
            local info=m:FindFirstChild("MapInfoGui")
            local vote=m:FindFirstChild("VoteInfoGui")
            local icon=info and info:FindFirstChild("MapIcon")
            local box=vote and vote:FindFirstChild("Container")
            local title=box and box:FindFirstChild("MapName")
            local tally=box and box:FindFirstChild("Votes")
            if not (pad and info and icon and title and tally) then return nil end
            return {pad=pad,info=info,icon=icon,title=title,tally=tally}
        end
        local pads={}
        local function bind(rootModel)
            for _,c in ipairs(pad_conns) do pcall(function() c:Disconnect() end) end
            table.clear(pad_conns) table.clear(pads)
            root=rootModel
            if not root then return end
            for _,m in ipairs(root:GetChildren()) do
                local e=shape(m)
                if e then pads[#pads+1]=e end
            end
        end
        local function choices()
            local out={}
            for _,e in ipairs(pads) do
                if e.info.Enabled and e.title.Text~="" and e.title.Text~="MAP NAME" then
                    if next(sel_map)==nil or sel_map[e.title.Text] then out[#out+1]=e end
                end
            end
            return out
        end
        local function begin(id)
            local list=choices()
            if #list==0 then finish() return end
            local e=list[math.random(1,#list)]
            spot=stand_point(e.pad)
            dupe_used=0 dupe_mark=tally_of(e)
            local char=LP.Character
            local hrp=char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then finish() return end
            origin=hrp.CFrame
            if not plant(spot) then finish() return end
            if not SHF.mapvote_dupe then
                task.delay(0.2,function() if session==id then finish() end end)
                return
            end
            hold_conn=RunService.Heartbeat:Connect(function()
                if session~=id or not spot then return end
                local c2=LP.Character
                local h2=c2 and c2:FindFirstChild("HumanoidRootPart")
                if not h2 then return end
                local flat=Vector3.new(h2.Position.X-spot.X,0,h2.Position.Z-spot.Z)
                if flat.Magnitude>2.5 then h2.CFrame=CFrame.new(spot) end
            end)
        end
        RunService.Heartbeat:Connect(function()
            if not SHF.mapvote then
                if running then finish() end
                return
            end
            if not running then
                local anyOpen=false
                for _,e in ipairs(pads) do if e.info.Enabled then anyOpen=true break end end
                if anyOpen then
                    running=true
                    session=session+1
                    begin(session)
                end
            end
        end)
        task.spawn(function()
            local lobby=workspace:FindFirstChild("SummerLobby")
            if lobby then bind(lobby:FindFirstChild("VotePads")) end
            lobby_conn=workspace.ChildAdded:Connect(function(c)
                if c.Name=="Lobby" or c.Name=="SummerLobby" then
                    task.defer(function() bind(c:FindFirstChild("VotePads")) end)
                end
            end)
        end)
    end
end
