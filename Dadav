            elseif flag=="fly" then ST.fly=new
            elseif flag=="inf_jump" then ST.inf_jump=new end
            local reg=getgenv().DaDa_UIRegistry
            if reg and reg[flag] then pcall(reg[flag], new) end
        end)
        qbuttons[feat.name]=b
