local function initHub()
    hubGui=Instance.new("ScreenGui")
    hubGui.Name="DaDaHub_"..math.random(1000,9999); hubGui.ResetOnSpawn=false; hubGui.IgnoreGuiInset=true; hubGui.DisplayOrder=100
    pcall(function() hubGui.Parent=CoreGui end)
