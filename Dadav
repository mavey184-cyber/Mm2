    local function knife_touch(k,part) local ev=k:FindFirstChild("Events"); local t=ev and ev:FindFirstChild("HandleTouched"); if t then pcall(function() t:FireServer(part) end) end end
    local last_ka=0
    killaura_step=function()
        if not (ST.killaura or ST.autoknife) then return end
