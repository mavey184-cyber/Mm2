    RunService.Stepped:Connect(farm_step)

    local FLING_MAX_VEL=700; local FLING_MAX_ANG=90; local FLING_HOLD=0.25; local FLING_SAFE_VEL=250
    local fling_safe_cf=nil; local fling_hold_until=0
