local function _avGetMapName(pad)
    local ok,result=pcall(function()
        local vg=pad:FindFirstChild("VoteInfoGui",true); if not vg then return nil end
        local c=vg:FindFirstChild("Container",true); if not c then return nil end
        local m=c:FindFirstChild("MapName",true); if not m then return nil end
        if m:IsA("TextLabel") or m:IsA("TextButton") or m:IsA("TextBox") then return m.Text
        elseif m:FindFirstChild("Text") then return m.Text.Value end
        return nil
    end)
    if ok then return result end; return nil
end
local function _avRespawn()
    local char=LocalPlayer.Character; if char then
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health=0 else char:Destroy() end
    end
    LocalPlayer.CharacterAdded:Wait(); task.wait(0.2)
end
local function _avTeleport(detectorNumber)
    local rl=Workspace:FindFirstChild("RegularLobby",true); if not rl then return false end
    local vp=rl:FindFirstChild("VotePads",true); if not vp then return false end
    local det=vp:FindFirstChild("Detector"..detectorNumber); if not det then return false end
    for i=1,TOTAL_TELEPORTS do
        if not autoVoteEnabled then return false end
        local char=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root=char:WaitForChild("HumanoidRootPart",5)
        if root then
            if det:IsA("BasePart") then root.CFrame=det.CFrame+Vector3.new(0,3,0)
            elseif det:IsA("Model") then
                local pr=det.PrimaryPart or det:FindFirstChildWhichIsA("BasePart",true)
                if pr then root.CFrame=pr.CFrame+Vector3.new(0,3,0) end
            end
        end
        task.wait(0.3); if not autoVoteEnabled then return false end; _avRespawn()
    end
    return true
end
task.spawn(function()
    while task.wait(0.5) do
        if autoVoteEnabled and targetMapName and targetMapName~="" and targetMapName~="None" then
            local rl=Workspace:FindFirstChild("RegularLobby")
            if rl then
                for padIndex=1,3 do
                    if not autoVoteEnabled then break end
                    local pad=rl:FindFirstChild("VotePad"..padIndex)
                    if pad then
                        local cm=_avGetMapName(pad)
                        if cm and string.find(string.lower(cm),string.lower(targetMapName),1,true) then
                            _avTeleport(padIndex)
                            repeat task.wait(1) until not autoVoteEnabled or not string.find(string.lower(_avGetMapName(pad) or ""),string.lower(targetMapName),1,true)
