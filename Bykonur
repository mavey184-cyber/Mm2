local function getRolePosition(roleName)
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local bp=p:FindFirstChild("Backpack")
            if roleName=="Murderer" and (p.Character:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))) then return p.Character.HumanoidRootPart.Position
            elseif roleName=="Sheriff" and (p.Character:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))) then return p.Character.HumanoidRootPart.Position end
        end
    end
    return nil
end

