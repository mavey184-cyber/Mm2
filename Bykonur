    if char and droppedGun and droppedGun:IsA("BasePart") then char:MoveTo(droppedGun.Position); return end
    for _,obj in ipairs(Workspace:GetDescendants()) do if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent.Name:lower():find("gun") then if char then char:MoveTo(obj.Parent.Position); return end end end
end)

