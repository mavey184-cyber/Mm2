-- AURA
local function removeAuraByName(auraName)
    local char=LocalPlayer.Character; if not char then return end
    local tag="DaDaAura_"..auraName
    for _,obj in ipairs(char:GetDescendants()) do if obj.Name==tag then obj:Destroy() end end
end
local function applyAuraByName(auraName)
    removeAuraByName(auraName); if not auraEnabled[auraName] then return end
    local auraId=AURA_IDS[auraName]; if not auraId then return end
    local char=LocalPlayer.Character; if not char then return end
    local ok,aura=pcall(function() return game:GetObjects(auraId)[1] end); if not ok or not aura then return end
    local parts={}; for _,part in ipairs(char:GetChildren()) do if part:IsA("BasePart") then parts[part.Name]=part end end
    for _,auraPart in ipairs(aura:GetChildren()) do
        local target=parts[auraPart.Name]
        if target then
            for _,effect in ipairs(auraPart:GetChildren()) do
                local clone=effect:Clone(); clone.Name="DaDaAura_"..auraName; clone.Parent=target
                for _,obj in ipairs(clone:GetDescendants()) do
                    if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail") then obj.Color=ColorSequence.new(AURA_COLOR); obj.Enabled=true
                    elseif obj:IsA("PointLight") then obj.Color=AURA_COLOR end
                end
                if clone:IsA("ParticleEmitter") then clone.Color=ColorSequence.new(AURA_COLOR); clone.Enabled=true end
            end
        end
    end
    aura:Destroy()
end
local function auraToggle(auraName,state)
    auraEnabled[auraName]=state
    local char=LocalPlayer.Character
    if state then
        if char then task.spawn(function() char:WaitForChild("Humanoid",5); task.wait(0.2); applyAuraByName(auraName) end) end
    else removeAuraByName(auraName) end
end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(1)
    for name,state in pairs(auraEnabled) do if state then applyAuraByName(name) end end
end)

