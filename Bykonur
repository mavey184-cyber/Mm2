local function saveFEAnimOriginals(animate)
    for _,v in pairs(FEAnimMap) do
        local folder=animate:FindFirstChild(v.folder)
        if folder then for _,s in ipairs(v.slots) do local anim=folder:FindFirstChild(s.child); if anim and anim:IsA("Animation") and anim.AnimationId~="" then FEAnimOriginals[s.origKey]=anim.AnimationId end end end
    end
